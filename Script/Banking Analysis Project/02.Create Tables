--Create bronze.accounts Table

IF OBJECT_ID ('bronze.accounts', 'U') IS NOT NULL
	DROP TABLE bronze.accounts;
CREATE TABLE bronze.accounts(
	account_id			NVARCHAR(100),
	customer_id			NVARCHAR(100),
	account_type		NVARCHAR(100),
	balance_usd			DECIMAL(18,2),
	open_date			  DATE

);


--Create bronze.branches Table

IF OBJECT_ID ('bronze.branches', 'U') IS NOT NULL
	DROP TABLE bronze.branches;
CREATE TABLE bronze.branches(
	branch_id			  NVARCHAR(100),
	branch_name			NVARCHAR(100),
	manager_name		NVARCHAR(100)

);


--Create bronze.cards Table

IF OBJECT_ID ('bronze.cards', 'U') IS NOT NULL
	DROP TABLE bronze.cards;
CREATE TABLE bronze.cards(
	card_id				    NVARCHAR(100),
	account_id			  NVARCHAR(100),
	card_type			    NVARCHAR(100),
	expiration_date		DATE

);


--Create bronze.customers Table

IF OBJECT_ID ('bronze.customers', 'U') IS NOT NULL
	DROP TABLE bronze.customers;
CREATE TABLE bronze.customers(
	customer_id			NVARCHAR(100),
	first_name			NVARCHAR(100),
	last_name		  	NVARCHAR(100),
	email				    NVARCHAR(100),
	city				    NVARCHAR(100),
	credit_score		INT,
	created_at			DATE

);


--Create bronze.loans Table

IF OBJECT_ID ('bronze.loans', 'U') IS NOT NULL
	DROP TABLE bronze.loans;
CREATE TABLE bronze.loans(
	loan_id				  NVARCHAR(100),
	customer_id			NVARCHAR(100),
	loan_amount			DECIMAL(18,2),
	interest_rate		DECIMAL(18,2),
	start_date			DATE

);


--Create bronze.loans merchants

IF OBJECT_ID ('bronze.merchants', 'U') IS NOT NULL
	DROP TABLE bronze.merchants;
CREATE TABLE bronze.merchants(
	merchant_id			NVARCHAR(100),
	merchant_name		NVARCHAR(100),
	city			    	NVARCHAR(100)

);
