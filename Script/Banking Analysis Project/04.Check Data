-- Check For Nulls and Duplicates

SELECT 
	account_id,
	COUNT(account_id)
FROM bronze.accounts
GROUP BY account_id
HAVING COUNT(account_id) > 1 OR account_id IS NULL;

-- Data Standardization & Consistency

SELECT DISTINCT
	account_type
FROM bronze.accounts

-- Check For Nulls and Duplicates

SELECT
	branch_id,
	COUNT(branch_id)
FROM bronze.branches
GROUP BY branch_id
HAVING COUNT(branch_id) > 1 OR branch_id IS NULL;

-- Check For Space 

SELECT 
	branch_name
FROM bronze.branches
WHERE 	branch_name != TRIM(branch_name);

